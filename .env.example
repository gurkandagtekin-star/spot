GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
ADMIN_KEY=
EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
API_PUBLIC_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
# Native Google Sign-In uses WEB client ID (idToken audience).
# Android OAuth client: package com.markdate.app + SHA-1.
# iOS OAuth client: bundle com.markdate.app; plugin iosUrlScheme = reversed iOS client id.
# Expo Go does not include this native module — use a development build.
# Redirect: {API_PUBLIC_URL}/auth/google/callback
# Yerel LAN (Expo): Authorized redirect URI olarak
# http://192.168.1.104:3001/auth/google/callback  ve  markdate://oauth
# Google özel IP için device_id / device_name sunucu ve AuthSession ekler.
# Docker: npm run docker:up  → API :3001 + Postgres
# Render: render.yaml  (DATABASE_URL, FORCE_HTTPS=1, API_PUBLIC_URL=https://…)
# DATABASE_URL=postgresql://user:pass@host:5432/markdate
# CORS_ORIGINS=https://markdate.app,https://www.markdate.app
# FORCE_HTTPS=1
# TRUST_PROXY=1
# PGSSL=1
# Instagram Login veya Consumer Facebook Login App ID (Ayarlar → Temel)
# Redirect: {API_PUBLIC_URL}/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# RevenueCat public SDK keys (Google Play Billing + App Store).
# Play Console + RC: products markdate_pro_monthly / markdate_pro_yearly
# Entitlement identifier: pro
# Offering: Current, packages Monthly + Annual attached to those products.
# Webhook: POST {API_PUBLIC_URL}/webhooks/revenuecat
# Authorization: Bearer {REVENUECAT_WEBHOOK_AUTH}
EXPO_PUBLIC_RC_GOOGLE_API_KEY=
EXPO_PUBLIC_RC_APPLE_API_KEY=
EXPO_PUBLIC_RC_ENTITLEMENT=pro
EXPO_PUBLIC_IAP_MONTHLY_ID=markdate_pro_monthly
EXPO_PUBLIC_IAP_YEARLY_ID=markdate_pro_yearly
REVENUECAT_WEBHOOK_AUTH=
# AdMob — leave empty to disable ads (no fake rewarded/interstitial).
EXPO_PUBLIC_ADMOB_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
