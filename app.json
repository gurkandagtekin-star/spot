{
  "expo": {
    "name": "Mark Date",
    "slug": "mark-date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b101d"
    },
    "scheme": "markdate",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mark Date uses your location to show nearby meetups."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mark Date accesses your library for profile and chat photos.",
          "cameraPermission": "Mark Date uses the camera to add photos to chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3CAC",
          "defaultChannel": "mark-date"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Mark Date can use Face ID to keep your sign-in key on this device."
        }
      ],
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "tr"],
            "android": ["en", "tr"]
          }
        }
      ],
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "expo-video",
      "react-native-purchases",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markdate.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Mark Date uses your location to show nearby meetups."
      }
    },
    "android": {
      "package": "com.markdate.app",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "androidStatusBar": {
        "translucent": false
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "markdate",
              "host": "oauth"
            },
            {
              "scheme": "markdate",
              "host": "chat",
              "pathPrefix": "/"
            },
            {
              "scheme": "markdate",
              "host": "chats"
            },
            {
              "scheme": "markdate",
              "host": "map"
            },
            {
              "scheme": "markdate",
              "host": "profile"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0b101d",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "en": "./languages/en.json",
      "tr": "./languages/tr.json"
    },
    "extra": {
      "eas": {
        "projectId": "ca7f4681-479e-4d40-8a75-eed95e0a1e3c"
      }
    },
    "owner": "rakbenadam",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca7f4681-479e-4d40-8a75-eed95e0a1e3c"
    }
  }
}
