{
  "expo": {
    "name": "Mark Date",
    "slug": "mark-date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16081F"
    },
    "scheme": "markdate",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mark Date, yakındaki buluşmaları göstermek için konumunu kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mark Date profil ve sohbet fotoğrafı için galeriye erişir.",
          "cameraPermission": "Mark Date sohbete fotoğraf eklemek için kamerayı kullanır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3CAC",
          "defaultChannel": "mark-date"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Mark Date, giriş anahtarını cihazda güvenle tutmak için Face ID kullanabilir."
        }
      ],
      "expo-web-browser",
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markdate.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mark Date, yakındaki buluşmaları göstermek için konumunu kullanır."
      }
    },
    "android": {
      "package": "com.markdate.app",
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "androidStatusBar": {
        "translucent": false
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "markdate",
              "host": "oauth"
            },
            {
              "scheme": "markdate",
              "host": "chat",
              "pathPrefix": "/"
            },
            {
              "scheme": "markdate",
              "host": "chats"
            },
            {
              "scheme": "markdate",
              "host": "map"
            },
            {
              "scheme": "markdate",
              "host": "profile"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ca7f4681-479e-4d40-8a75-eed95e0a1e3c"
      }
    },
    "owner": "rakbenadam",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca7f4681-479e-4d40-8a75-eed95e0a1e3c"
    }
  }
}
